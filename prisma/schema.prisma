// Prisma Schema File
// Think of this as a "class definition" for your database tables.
// Each `model` below becomes a PostgreSQL table, and Prisma
// auto-generates TypeScript types from it.

// Generator: tells Prisma to generate a TypeScript client
// so you can do prisma.user.findMany() etc.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Datasource: which database engine and where to find it.
// It reads DATABASE_URL from your .env file.
datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// User Model
// ──────────────────────────────────────────────
// This is like a Java class that maps to a "users" table.
// Prisma uses the model name for the table (lowercased + pluralized
// by convention in the DB, but you query it as `prisma.user`).
model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  hashedPassword String
  image          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // ─── Relations ───
  // These aren't columns in the database — they're Prisma's way of
  // expressing relationships so you can do things like:
  //   const user = await prisma.user.findUnique({
  //     where: { id },
  //     include: { ownedBoards: true, boardMemberships: true }
  //   });
  //
  // Think of it like Java's @OneToMany annotation — it tells the ORM
  // "this User can have many Boards they own and many BoardMember records."
  ownedBoards      Board[]         @relation("BoardOwner")
  boardMemberships BoardMember[]
  createdCards     Card[]          @relation("CardCreator")
  // Phase 4: cards this user is assigned to (via CardAssignee join table)
  assignedCards    CardAssignee[]
  // Phase 5: comments and activity entries created by this user
  comments         Comment[]
  activities       Activity[]

  @@map("users")
}

// ──────────────────────────────────────────────
// Role Enum
// ──────────────────────────────────────────────
// PostgreSQL supports native enums (unlike MySQL which fakes them).
// Prisma creates a real PostgreSQL enum type in the database.
//
// OWNER: Full control — can delete the board, manage members
// ADMIN: Can edit board settings and manage members (but can't delete)
// MEMBER: Can view and interact with cards (the default role)
enum Role {
  OWNER
  ADMIN
  MEMBER
}

// ──────────────────────────────────────────────
// Board Model
// ──────────────────────────────────────────────
// Represents a Kanban board (like a Trello board or Jira project).
// Each board has columns (Phase 3) which contain cards.
model Board {
  id          String   @id @default(cuid())
  title       String
  description String?  // Optional — not every board needs a description
  color       String   @default("#3B82F6") // Hex color for the card accent (defaults to blue)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ─── Owner Relation ───
  // Every board has one owner (the person who created it).
  // `ownerId` is a foreign key pointing to User.id.
  //
  // The @relation("BoardOwner") name matches the relation on User.ownedBoards.
  // This is needed because User has TWO relations to Board-related models,
  // and Prisma needs to know which is which (like naming your foreign keys in SQL).
  ownerId String
  owner   User   @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // ─── Members ───
  // A board has many members (via the BoardMember join table).
  members BoardMember[]

  // ─── Columns ───
  // A board has many columns (To Do, In Progress, Done, etc.).
  // Added in Phase 3 for the Kanban board view.
  columns Column[]
  // Phase 4: labels that belong to this board (shared across all cards)
  labels  Label[]
  // Phase 5: activity log for this board
  activities Activity[]

  @@map("boards")
}

// ──────────────────────────────────────────────
// BoardMember Model (Join Table)
// ──────────────────────────────────────────────
// This is a "join table" (also called "junction table" or "pivot table").
// You learned about these in database normalization:
//
//   User ←── BoardMember ──→ Board
//        (many-to-many with extra data)
//
// WHY NOT just an array of user IDs on Board?
// Because we need to store EXTRA DATA about the relationship:
// the user's role (OWNER/ADMIN/MEMBER). A simple array can't do that.
//
// This is exactly like an "enrollment" table in a university DB:
//   Student ←── Enrollment ──→ Course
//   (with extra data: grade, semester, etc.)
model BoardMember {
  id       String   @id @default(cuid())
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())

  // ─── Foreign Keys ───
  userId  String
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  boardId String
  board   Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  // ─── Unique Constraint ───
  // A user can only be a member of a board ONCE.
  // Without this, you could accidentally add Alice to "Sprint 23" twice.
  // This is like a composite primary key in SQL:
  //   PRIMARY KEY (user_id, board_id)
  // But we keep a separate `id` for easier querying.
  @@unique([userId, boardId])
  @@map("board_members")
}

// ──────────────────────────────────────────────
// Column Model
// ──────────────────────────────────────────────
// Represents a column on a Kanban board (e.g., "To Do", "In Progress", "Done").
// Columns are ordered left-to-right by `position`.
//
// Think of it like a linked list stored as an array:
//   position 0 = leftmost column, position 1 = next, etc.
// When you drag a column to reorder, we update the positions of ALL columns
// in that board (like re-indexing an array after an insert/remove).
model Column {
  id       String @id @default(cuid())
  title    String
  position Int    // 0-based ordering: 0 = leftmost, 1 = next, etc.

  // ─── Board Relation ───
  // Every column belongs to exactly one board.
  // onDelete: Cascade means if the board is deleted, all its columns go too.
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  // ─── Cards ───
  // A column has many cards, ordered by their `position` field.
  cards Card[]

  // ─── Index ───
  // We frequently query "all columns for board X, ordered by position",
  // so this composite index speeds up that query.
  // Think of it like a database index on (boardId, position) in SQL:
  //   CREATE INDEX idx_columns_board_pos ON columns(board_id, position);
  @@index([boardId, position])
  @@map("columns")
}

// ──────────────────────────────────────────────
// Card Model
// ──────────────────────────────────────────────
// Represents a task card within a column (like a sticky note on a Kanban board).
// Cards are the core unit of work — they have a title, optional description,
// and are ordered top-to-bottom by `position` within their column.
//
// In later phases, cards will gain: labels, assignees, comments, attachments, due dates.
// We include `description` and `dueDate` now to avoid a migration later in Phase 4.
model Card {
  id          String    @id @default(cuid())
  title       String
  description String?   // Optional rich text (Markdown in Phase 4)
  position    Int       // 0-based ordering within the column
  dueDate     DateTime? // Optional deadline (used in Phase 4)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // ─── Column Relation ───
  // Every card belongs to exactly one column.
  // When a card is dragged to a different column, we update this foreign key.
  // onDelete: Cascade means if the column is deleted, all its cards go too.
  // (And since columns cascade from boards, deleting a board removes everything.)
  columnId String
  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)

  // ─── Creator Relation ───
  // Who created this card. Useful for activity logs and permissions.
  // We use a named relation ("CardCreator") because User will eventually have
  // MULTIPLE relations to Card (creator, assignees), and Prisma needs to
  // distinguish them — same reason we named "BoardOwner" earlier.
  creatorId String
  creator   User   @relation("CardCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  // Phase 4: labels and assignees (many-to-many via join tables)
  labels    CardLabel[]
  assignees CardAssignee[]
  // Phase 5: comments and activity entries on this card
  comments   Comment[]
  activities Activity[]

  // ─── Index ───
  // Same rationale as columns: we always query "cards in column X, ordered by position".
  @@index([columnId, position])
  @@map("cards")
}

// ──────────────────────────────────────────────
// Label Model
// ──────────────────────────────────────────────
// Labels are board-scoped colored tags (like GitHub issue labels).
// A label belongs to one board but can be applied to many cards.
// Cards reference labels through the CardLabel join table.
model Label {
  id      String @id @default(cuid())
  name    String
  color   String // Hex color, e.g. "#EF4444"

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  cards   CardLabel[]

  @@map("labels")
}

// ──────────────────────────────────────────────
// CardLabel Model (Join Table)
// ──────────────────────────────────────────────
// Many-to-many between Card and Label.
// A card can have many labels; a label can be on many cards.
// Uses a composite primary key instead of a separate id column.
model CardLabel {
  cardId  String
  labelId String

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@map("card_labels")
}

// ──────────────────────────────────────────────
// CardAssignee Model (Join Table)
// ──────────────────────────────────────────────
// Many-to-many between Card and User.
// A card can have many assignees; a user can be assigned to many cards.
// Only board members can be assigned (enforced in the tRPC router).
model CardAssignee {
  cardId String
  userId String

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
  @@map("card_assignees")
}

// ──────────────────────────────────────────────
// Comment Model
// ──────────────────────────────────────────────
// A comment is a text message left by a user on a specific card.
// Think of it like a GitHub issue comment: threaded, author-attributed,
// and shown in reverse-chronological order (newest first).
//
// WHO CAN COMMENT?
// Any board member can comment on any card. Editing/deleting is
// restricted to the comment's author (enforced in the tRPC router).
model Comment {
  id        String   @id @default(cuid())
  content   String
  cardId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // We frequently query "all comments for card X, newest first"
  @@index([cardId, createdAt])
  @@map("comments")
}

// ──────────────────────────────────────────────
// Activity Model
// ──────────────────────────────────────────────
// An immutable log entry recording what happened on a board.
// Think of it like an audit trail or GitHub's "Alice added label 'Bug'" entries.
//
// Each activity records:
//   - WHO did it (userId → User)
//   - WHERE it happened (boardId, optional cardId)
//   - WHAT happened (action string like "moved_card")
//   - DETAILS (JSON with extra context: card name, column name, etc.)
//
// WHY JSON for details?
// Different actions have different context. Instead of making 20 nullable
// columns, we store a flexible JSON blob. The frontend parses it per action type.
//
// WHY onDelete: SetNull for card?
// If a card is deleted, we want to keep the activity log entry (it records history),
// but we null-out the card reference since the card no longer exists.
model Activity {
  id        String   @id @default(cuid())
  boardId   String
  cardId    String?
  userId    String
  action    String   // e.g. "created_card", "moved_card", "added_label"
  details   Json     @default("{}")
  createdAt DateTime @default(now())

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  card  Card?  @relation(fields: [cardId], references: [id], onDelete: SetNull)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([boardId, createdAt])
  @@index([cardId, createdAt])
  @@map("activities")
}
